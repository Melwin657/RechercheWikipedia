<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/ffffff"
    >


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rechercher_sur_wikipedia"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/_000000"
        android:layout_marginBottom="16dp"
        />


    <EditText
        android:id="@+id/zonepourentrerlarecherche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Veuillez entrer l'élément à rechercher"
        android:inputType="text"
        android:layout_marginBottom="12dp"
        />


    <Button
        android:id="@+id/bouttonpourlancerlarecherche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rechercher"
        android:layout_marginBottom="16dp"
        />


    <ProgressBar
        android:id="@+id/recherche"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >


        <TextView
            android:id="@+id/sectiondaffichageduresultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="@color/_333333"
            android:lineSpacingExtra="4dp"
            />


    </ScrollView>



</LinearLayout>
